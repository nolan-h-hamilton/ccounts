include LICENSE
include HTSLIB_LICENSE.txt
include HTSCODECS_LICENSE.md
include ZLIB_LICENSE.txt
include .github/scripts/installHDF5.sh
recursive-include src/ccounts *.pyx *.pxd *.pxi *.h *.c
recursive-include src/ccounts/data/gaps *.bed.gz *.json
recursive-include src/ccounts/mappability *.npz *.json
include scripts/buildMappability.py scripts/buildMappability.cpp
include scripts/verifyMappability.py
graft vendor/htslib
prune vendor/htslib/.git
prune vendor/htslib/.github
prune vendor/htslib/test
prune vendor/htslib/samples
prune vendor/htslib/htscodecs/tests
prune vendor/htslib/htscodecs/javascript
prune build
prune dist
global-exclude __pycache__ .DS_Store *.pyc *.so *.dylib *.dll *.o *.a
exclude vendor/htslib/config.h
exclude vendor/htslib/config.mk
exclude vendor/htslib/config_vars.h
exclude vendor/htslib/htscodecs.mk
recursive-include tests *.py *.tsv *.bam *.bai *.sizes *.bedGraph *.h5ad *.txt
